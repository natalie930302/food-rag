# ===== OpenAI =====
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=1500

# ===== Embedding(本地) =====
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu
EMBED_BATCH_SIZE=32

# ===== OCR =====
TESSERACT_LANG=chi_tra+eng
OCR_DPI=200
OCR_MIN_CHARS_PER_PAGE=30

# ===== 路徑 =====
DATA_DIR=./data
RAW_DIR=./data/raw
PROCESSED_DIR=./data/processed
INDEX_DIR=./data/index
CONVERTED_DIR=./data/converted

# ===== 外部工具 =====
LIBREOFFICE_BIN=libreoffice

# ===== API =====
LOG_LEVEL=INFO

# ===== Chunking =====
CHUNK_MAX_LEN=600
CHUNK_MIN_LEN=30
CHUNK_OVERLAP=50

# Reranker 裝置(預設 cpu)。4 GB 顯卡放不下兩個 fp32 模型,只把 reranker 放 GPU 並用 fp16:
# RERANKER_DEVICE=cuda
# RERANKER_FP16=true
